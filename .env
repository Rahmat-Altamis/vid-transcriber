# --- Required ---
GROQ_API_KEY=##key
HACKCLUB_API_KEY=#key

# --- Groq: endpoints & models ---
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3
TEXT_MODEL=hackclub:openai/gpt-5.5
JUDGE_FALLBACK_MODEL=hackclub:xiaomi/mimo-v2.5
JUDGE_THRESHOLD=0.7

# --- Hack Club AI: endpoint & vision model ---
HACKCLUB_BASE_URL=https://ai.hackclub.com/proxy/v1
VISION_MODEL=hackclub:anthropic/claude-opus-4.8
_BASE_URL=https://ai.hackclub.com/proxy/v1

# --- Pipeline tuning ---
MIN_FRAMES=6
MAX_FRAMES=14
FRAME_EVERY_SEC=8
MAX_VISION_IMAGES=14
USE_AUDIO=true
MAX_PARALLEL_VIDEOS=4

# --- Local dev paths ---
INPUT_PATH=./input/tasks.json
OUTPUT_PATH=./output/results.json